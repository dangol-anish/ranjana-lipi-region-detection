{
  "expo": {
    "name": "Ranjana Lipi Handwriting Learner",
    "slug": "ranjana-lipi-coach",
    "scheme": "ranjanalipicoach",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Use the camera to photograph handwriting practice attempts.",
        "NSPhotoLibraryUsageDescription": "Choose handwriting practice images from your photo library."
      }
    },
    "android": {
      "package": "com.anishdangol.ranjanalipicoach",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": ["android.permission.RECORD_AUDIO"]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose handwriting practice images for region feedback.",
          "cameraPermission": "Photograph handwriting practice attempts for region feedback."
        }
      ],
      "@react-native-google-signin/google-signin",
      "expo-web-browser"
    ],
    "extra": {
      "eas": {
        "projectId": "f19275e3-b967-4c1a-8c0e-41133da24542"
      }
    }
  }
}
